rules_version = '2';

// Модель доступа — без Firebase Authentication: «ключ = пароль».
// Кто знает точный ключ в пути документа, тот имеет доступ; без ключа
// документ не найти, потому что листинг верхних коллекций запрещён.
//
//  • teacherSpaces/{ключ учителя}/...   — всё хозяйство тьютора.
//    Ключ учителя НЕ хранится в коде сайта: он вводится один раз на
//    устройстве (ссылка .../#t=КЛЮЧ) и живёт в localStorage браузера.
//  • parentAccess/{ключ родителя}       — витрина для родителя (только
//  • studentAccess/{ключ ученика}         его ребёнок + «занято» без имён).
//    Витрины публикует кабинет учителя. У каждого родителя/ученика свой
//    ключ; отзыв ключа = удаление витрины.
//  • channels/{ключ канала}/items          — то, что пишут родитель/ученик
//    (ДЗ, заявки, «оплачено»). У каждого ученика общий канал (родитель +
//    ученик) и отдельный родительский (оплата). Учитель проверяет, что
//    каждое сообщение относится к занятию именно этого ученика.
service cloud.firestore {
  match /databases/{database}/documents {

    // Первый ключ учителя попал в публичный index.html (сентябрь 2026),
    // поэтому он выведен из оборота: данные перенесены на новый ключ,
    // а старый путь закрыт полностью.
    function liveTeacher(teacherId) {
      return teacherId != "2Vv0fLQi3MXbEgqpwlmWk5E1KnVRz9-q"
        && teacherId.size() >= 24;
    }

    function validLesson(d) {
      return d.startMs is int
        && d.endMs is int
        && d.endMs > d.startMs
        && d.title is string && d.title.size() <= 200
        && d.status in ["planned", "done", "cancelled", "rescheduled"];
    }

    // Сообщение в канале ученика. Каналы — единственное место, куда пишут
    // родитель и ученик: загруженное ДЗ, заявки на перенос/отмену, отметка
    // «оплачено». Только создание (менять чужие сообщения нельзя), состав
    // полей и размеры ограничены; ссылки на файлы — только Cloudinary.
    function validItem(d) {
      return d.keys().hasOnly(["type", "lessonId", "by", "createdAt", "file", "newStartMs", "newEndMs", "comment", "paid"])
        && d.type in ["homework", "reschedule", "cancel", "paid"]
        && d.lessonId is string && d.lessonId.size() > 0 && d.lessonId.size() <= 128
        && d.by in ["parent", "student", "teacher"]
        && d.createdAt is int
        && (!("comment" in d) || (d.comment is string && d.comment.size() <= 500))
        && (d.type != "homework" || (
              d.file is map
              && d.file.keys().hasOnly(["url", "name"])
              && d.file.url is string && d.file.url.size() <= 500
              && d.file.url.matches("^https://res[.]cloudinary[.]com/.*")
              && d.file.name is string && d.file.name.size() <= 200))
        && (d.type != "reschedule" || (d.newStartMs is int && d.newEndMs is int && d.newEndMs > d.newStartMs))
        && (d.type != "paid" || d.paid is bool);
    }

    function validView(d) {
      return d.v == 1
        && d.role in ["parent", "student"]
        && d.lessons is list && d.lessons.size() <= 500
        && d.busy is list && d.busy.size() <= 1500;
    }

    match /teacherSpaces/{teacherId}/state/{stateDoc} {
      allow get, write: if liveTeacher(teacherId);
    }

    // Листинг здесь разрешён: чтобы что-то перечислить, всё равно нужно
    // знать ключ учителя в пути.
    match /teacherSpaces/{teacherId}/lessons/{lessonId} {
      allow get, list, delete: if liveTeacher(teacherId);
      allow create, update: if liveTeacher(teacherId) && validLesson(request.resource.data);
    }

    match /teacherSpaces/{teacherId}/accessKeys/{accessKey} {
      allow get, list, write: if liveTeacher(teacherId);
    }

    // Журнал решений по заявкам (подтверждено/отклонено) — только учитель.
    match /teacherSpaces/{teacherId}/requests/{requestId} {
      allow get, list, write: if liveTeacher(teacherId);
    }

    // Каналы учеников: channels/{ключ канала}/items/{id}. Ключ канала знает
    // учитель и те, кому он выдан в витрине (родитель/ученик ЭТОГО ребёнка).
    // При отзыве доступа учитель заводит новый канал, старый пустеет.
    match /channels/{channelKey}/items/{itemId} {
      allow get, list, delete: if channelKey.size() >= 24;
      allow create: if channelKey.size() >= 24 && validItem(request.resource.data);
      allow update: if false;
    }

    // Витрины: читать можно только точечно по ключу, перечислять нельзя.
    // Писать технически может и владелец ключа (без Auth это не отличить),
    // но испортить он может только свою же витрину — при следующей
    // публикации кабинет учителя её перезапишет.
    match /parentAccess/{accessKey} {
      allow get: if true;
      allow create, update: if accessKey.size() >= 24 && validView(request.resource.data);
      allow delete: if accessKey.size() >= 24;
    }
    match /studentAccess/{accessKey} {
      allow get: if true;
      allow create, update: if accessKey.size() >= 24 && validView(request.resource.data);
      allow delete: if accessKey.size() >= 24;
    }

    // Всё остальное (в т.ч. листинг teacherSpaces, parentAccess,
    // studentAccess и collection-group запросы) — запрещено.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
